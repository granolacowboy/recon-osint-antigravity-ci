# Local bind addresses. Keep loopback-only for the AUTH_ENABLED=false profile.
BIND_ADDRESS=127.0.0.1
API_PORT=8000
FRONTEND_PORT=4173
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
IMAGE_TAG=local

# Generated automatically by scripts/start.ps1 or scripts/start.sh.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# Local development only. Production must set AUTH_ENABLED=true and configure OIDC.
AUTH_ENABLED=false
LOCAL_PRINCIPAL_SUB=local-development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=["RS256"]
OIDC_LEEWAY_SECONDS=30
OIDC_JWKS_TIMEOUT_SECONDS=5
OIDC_JWKS_CACHE_SECONDS=300
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_ROLE=recon-admin
MAX_AUTHORIZATION_HEADER_BYTES=8192
OPERATIONS_TOKEN=
ENABLE_API_DOCS=true

# SPA Authorization Code + PKCE settings. Leave blank only for the loopback
# AUTH_ENABLED=false profile. Client IDs are public identifiers, not secrets.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_URI=

# Credentialed CORS requires an exact allow-list; wildcards are rejected.
CORS_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]

# Active collection remains disabled unless policy and request consent both allow it.
ALLOW_ACTIVE_SCANNING=false
ACTIVE_TARGET_ALLOWLIST=[]

# Work and request limits.
MAX_BATCH_SIZE=25
MAX_ADAPTERS_PER_SCAN=25
MAX_CONCURRENT_TASKS=10
MAX_QUEUE_DEPTH=100
MAX_OUTSTANDING_SCANS_PER_PRINCIPAL=10
MAX_REQUEST_BODY_BYTES=65536
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_HEALTH_INTERVAL_SECONDS=10
WORKER_LEASE_HEARTBEAT_SECONDS=10
RUNNING_SCAN_LEASE_SECONDS=60
DISPATCH_SWEEP_SECONDS=2
DEFAULT_TIMEOUT=60
PROCESS_TERMINATION_GRACE_SECONDS=2
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SCAN_EVENT_POLL_SECONDS=0.5
SCAN_EVENT_MAX_SECONDS=300
SCAN_EVENT_MAX_CONNECTIONS_PER_PRINCIPAL=3
DATA_RETENTION_DAYS=90
RETENTION_SWEEP_SECONDS=3600

# Optional passive-provider credential. An absent key keeps the adapter unavailable.
SHODAN_API_KEY=
